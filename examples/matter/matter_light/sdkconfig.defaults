# Matter-mirror CCT light: the RainMaker Neo data model is the canonical model; the
# Matter tree is derived from it by the esp_rmaker_neo_matter_mirror component.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Increase FreeRTOS timer task stack depth.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072

# Task priorities, stated in full. CHIP and the work queue are peers: both
# bring state in, and the mirror renders what they produce, so it sits below.
CONFIG_CHIP_TASK_PRIORITY=6
CONFIG_RMAKER_WORK_QUEUE_TASK_PRIORITY=6
CONFIG_ESP_RMAKER_NEO_MATTER_MIRROR_TASK_PRIORITY=5
CONFIG_OSAL_MQTT_AGENT_TASK_PRIORITY=4
CONFIG_ESP_RMAKER_CONSOLE_TASK_PRIORITY=2

# BLE is used for RainMaker provisioning (onboarding: on-network variant).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
CONFIG_APP_NETWORK_PROV_COMPACT_QR=y

# Compile the mapping tables for lightbulbs alone: other device types, and the
# capabilities and composites only they reference, stay out of the build.
CONFIG_ESP_RMAKER_NEO_MATTER_MIRROR_PROFILE_LIGHT=y

# Matter commissioning as the default.
CONFIG_ESP_RMAKER_NEO_MATTER_MIRROR_ONBOARD_MATTER_FIRST=y

# Matter factory data lives in the same partition as the RainMaker credentials.
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"
CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=y
CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_ENABLE_ESP32_DEVICE_INFO_PROVIDER=y
CONFIG_CUSTOM_DEVICE_INFO_PROVIDER=y
# Disable assisted claiming (factory partition is a pre-requisite).
CONFIG_ESP_RMAKER_ASSISTED_CLAIM=n

# Enable HKDF for esp-matter.
CONFIG_MBEDTLS_HKDF_C=y

# Optimize for size.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
# Use log version 2.
CONFIG_LOG_VERSION_2=y
# Both the full RainMaker stack and Matter are on board: trim the big flash
# consumers so the image fits the 4MB dual-OTA layout.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# RainMaker BLE provisioning uses legacy advertising only.
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
# Human-readable mbedTLS error strings are not worth the flash here.
CONFIG_MBEDTLS_ERROR_STRINGS=n
# The mbedTLS algorithm self-tests are development-only.
CONFIG_MBEDTLS_SELF_TEST=n
# Nothing here terminates TLS: the local HTTP endpoints are plain HTTP, Matter has its own
# CASE/PASE crypto, and MQTT is the client side.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# Matter and AWS IoT both use P-256, RainMaker BLE provisioning uses Curve25519; drop the rest.
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# Wi-Fi is station-only here (provisioning is over BLE); drop SoftAP support.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
# No debugger-over-UART use in this example.
CONFIG_ESP_GDBSTUB_ENABLED=n
# RISC-V: emit shared save/restore libcalls instead of inline prologues
# (a few percent of .text for a tiny call overhead).
CONFIG_COMPILER_SAVE_RESTORE_LIBCALLS=y

# Heap: Matter, the RainMaker Neo agent and MQTT/TLS all share the ~140KB of internal DRAM
# left on the ESP32-C3. The defaults below are sized for a node running one stack,
# not three; without them CHIP packet-buffer allocations fail during commissioning.
# Wi-Fi buffers: the dynamic counts are the peak the driver may hold at once.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
# mbedTLS: allocate the TLS record buffers per handshake and drop the peer cert and
# config data once the session is up, instead of holding ~16KB for the MQTT link.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# LwIP: MQTT, the chal-resp HTTP server, CHIP and mDNS between them need far fewer
# PCBs than the defaults reserve, and a shorter tcpip mailbox caps queued pbufs.
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=8
CONFIG_LWIP_MAX_UDP_PCBS=12
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_LOOPBACK_MAX_PBUFS=4

# Exclude unused clusters to optimize flash and memory usage
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_STREAM_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_ETHERNET_NETWORK_DIAGNOSTICS_CLUSTER=n
CONFIG_SUPPORT_FLOW_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_HUMIDISTAT_CLUSTER=n
CONFIG_SUPPORT_ILLUMINANCE_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_JOINT_FABRIC_ADMINISTRATOR_CLUSTER=n
CONFIG_SUPPORT_JOINT_FABRIC_DATASTORE_CLUSTER=n
CONFIG_SUPPORT_NETWORK_IDENTITY_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_OTA_SOFTWARE_UPDATE_PROVIDER_CLUSTER=n
CONFIG_SUPPORT_PRESSURE_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_PROXIMITY_RANGING_CLUSTER=n
CONFIG_SUPPORT_RELATIVE_HUMIDITY_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_SCENES_CLUSTER=n
CONFIG_SUPPORT_SOIL_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_TEMPERATURE_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_TLS_CERTIFICATE_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_TLS_CLIENT_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_WEB_RTC_TRANSPORT_PROVIDER_CLUSTER=n
CONFIG_SUPPORT_WEB_RTC_TRANSPORT_REQUESTOR_CLUSTER=n
