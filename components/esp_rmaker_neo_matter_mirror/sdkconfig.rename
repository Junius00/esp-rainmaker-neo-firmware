# Kconfig prefix moved onto the component name: RMNG_MATTER_MIRROR_* -> ESP_RMAKER_NEO_MATTER_MIRROR_*.
# Keeps an existing sdkconfig working instead of silently dropping these settings.
CONFIG_RMNG_MATTER_MIRROR_TASK_STACK   CONFIG_ESP_RMAKER_NEO_MATTER_MIRROR_TASK_STACK
CONFIG_RMNG_MATTER_MIRROR_TASK_PRIORITY CONFIG_ESP_RMAKER_NEO_MATTER_MIRROR_TASK_PRIORITY
