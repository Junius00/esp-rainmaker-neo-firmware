{
  "mapping_version": "1.0",
  "description": "Declarative bidirectional mapping between RainMaker Neo standard capabilities and Matter clusters/attributes. Consumed by the firmware Matter mirror (lowering) and, in future, by raising engines (apps/bridges). See docs/spec/common_data_model_draft.md section 4. A capability's matter_match is the Matter location it maps to, carrying its own value_type: how a value is wrapped on the Matter side is declared here, not inferred. A match with node_scoped lives on the root endpoint. Composites keep a single matter_match object: one cluster with N derived attributes.",
  "capabilities": [
    {
      "capability": "esp.param.power",
      "matter_match": {
        "cluster": "0x0006",
        "attribute": "0x0000",
        "value_type": "bool"
      },
      "transform": {
        "type": "identity"
      },
      "write_as": {
        "note": "Desired state, so On/Off selected by value - Toggle (0x02) is not idempotent",
        "commands": [
          {
            "when": 0,
            "command": "0x00",
            "name": "Off",
            "args": []
          },
          {
            "when": 1,
            "command": "0x01",
            "name": "On",
            "args": []
          }
        ]
      },
      "startup": {
        "attribute": "0x4003",
        "policy": "toggle_previous",
        "skip_on_software_update": true,
        "note": "StartUpOnOff: 0/1 assert Off/On at boot, 2 toggles the previous state. Skipped after an OTA restart, matching CHIP's own policy (a software update is not a power cycle)."
      },
      "defaults": {
        "data_type": "bool",
        "ui_type": "esp.ui.toggle",
        "properties": [
          "read",
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.brightness",
      "matter_match": {
        "cluster": "0x0008",
        "attribute": "0x0000",
        "value_type": "nullable_u8"
      },
      "transform": {
        "type": "linear",
        "in_min": 0,
        "in_max": 100,
        "out_min": 1,
        "out_max": 254
      },
      "write_as": {
        "commands": [
          {
            "command": "0x04",
            "name": "MoveToLevelWithOnOff",
            "args": [
              {
                "field": 0,
                "name": "Level",
                "type": "u8",
                "value": "$value"
              },
              {
                "field": 1,
                "name": "TransitionTime",
                "type": "u16",
                "value": 0
              },
              {
                "field": 2,
                "name": "OptionsMask",
                "type": "u8",
                "value": 0
              },
              {
                "field": 3,
                "name": "OptionsOverride",
                "type": "u8",
                "value": 0
              }
            ]
          }
        ]
      },
      "startup": {
        "attribute": "0x4000",
        "policy": "min_clamp",
        "min": 1,
        "note": "StartUpCurrentLevel: 0 means the minimum level per spec, and the mirror's LevelControl minimum is 1."
      },
      "deferred_persistence": true,
      "defaults": {
        "data_type": "int",
        "ui_type": "esp.ui.slider",
        "properties": [
          "read",
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.cct",
      "matter_match": {
        "cluster": "0x0300",
        "feature_map": "0x00000010",
        "attribute": "0x0007",
        "value_type": "u16"
      },
      "transform": {
        "type": "kelvin_mireds"
      },
      "write_as": {
        "commands": [
          {
            "command": "0x0A",
            "name": "MoveToColorTemperature",
            "args": [
              {
                "field": 0,
                "name": "ColorTemperatureMireds",
                "type": "u16",
                "value": "$value"
              },
              {
                "field": 1,
                "name": "TransitionTime",
                "type": "u16",
                "value": 0
              },
              {
                "field": 2,
                "name": "OptionsMask",
                "type": "u8",
                "value": 0
              },
              {
                "field": 3,
                "name": "OptionsOverride",
                "type": "u8",
                "value": 0
              }
            ]
          }
        ]
      },
      "bounds_from": {
        "min": "attr:0x400C",
        "max": "attr:0x400B",
        "value_type": "u16",
        "note": "min/max are the param's bounds and each names the attribute it lands on. kelvin_mireds is decreasing, so the kelvin min lands on 0x400C ColorTempPhysicalMaxMireds and the kelvin max on 0x400B ColorTempPhysicalMinMireds"
      },
      "startup": {
        "attribute": "0x4010",
        "policy": "passthrough",
        "note": "StartUpColorTemperatureMireds: the stored mireds value is asserted as-is at boot."
      },
      "deferred_persistence": true,
      "defaults": {
        "data_type": "int",
        "ui_type": "esp.ui.slider",
        "properties": [
          "read",
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.hue",
      "matter_match": {
        "cluster": "0x0300",
        "feature_map": "0x00000001",
        "attribute": "0x0000",
        "value_type": "u8"
      },
      "transform": {
        "type": "linear",
        "in_min": 0,
        "in_max": 360,
        "out_min": 0,
        "out_max": 254
      },
      "write_as": {
        "commands": [
          {
            "command": "0x00",
            "name": "MoveToHue",
            "args": [
              {
                "field": 0,
                "name": "Hue",
                "type": "u8",
                "value": "$value"
              },
              {
                "field": 1,
                "name": "Direction",
                "type": "u8",
                "value": 0
              },
              {
                "field": 2,
                "name": "TransitionTime",
                "type": "u16",
                "value": 0
              },
              {
                "field": 3,
                "name": "OptionsMask",
                "type": "u8",
                "value": 0
              },
              {
                "field": 4,
                "name": "OptionsOverride",
                "type": "u8",
                "value": 0
              }
            ]
          }
        ]
      },
      "seed_as": {
        "note": "CHIP keeps CurrentHue/CurrentSaturation in transition-state structs that only a Move/Step command initialises, while its HSV tick writes both attributes from both states: the first MoveToHue since boot would assert a saturation of 0 over the seeded one. StopMoveStep is the only command that re-reads both from the attribute store without writing either - every Move/Step alternative schedules the tick - so it is declared on both HS capabilities and sent once per (endpoint, cluster, command).",
        "commands": [
          {
            "command": "0x47",
            "name": "StopMoveStep",
            "args": [
              {
                "field": 0,
                "name": "OptionsMask",
                "type": "u8",
                "value": 1
              },
              {
                "field": 1,
                "name": "OptionsOverride",
                "type": "u8",
                "value": 1
              }
            ]
          }
        ]
      },
      "rule_gated": true,
      "note": "rule_gated: lowers only for device rules that list it - keeps ColorControl off device types (e.g. 0x0101 Dimmable Light) whose Matter definition forbids it.",
      "defaults": {
        "data_type": "int",
        "ui_type": "esp.ui.hue-slider",
        "properties": [
          "read",
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.saturation",
      "matter_match": {
        "cluster": "0x0300",
        "feature_map": "0x00000001",
        "attribute": "0x0001",
        "value_type": "u8"
      },
      "transform": {
        "type": "linear",
        "in_min": 0,
        "in_max": 100,
        "out_min": 0,
        "out_max": 254
      },
      "write_as": {
        "commands": [
          {
            "command": "0x03",
            "name": "MoveToSaturation",
            "args": [
              {
                "field": 0,
                "name": "Saturation",
                "type": "u8",
                "value": "$value"
              },
              {
                "field": 1,
                "name": "TransitionTime",
                "type": "u16",
                "value": 0
              },
              {
                "field": 2,
                "name": "OptionsMask",
                "type": "u8",
                "value": 0
              },
              {
                "field": 3,
                "name": "OptionsOverride",
                "type": "u8",
                "value": 0
              }
            ]
          }
        ]
      },
      "seed_as": {
        "note": "Same shadow as esp.param.hue's seed_as: StopMoveStep initialises the hue and saturation transition states together, so it is declared on both and the engine sends it once per (endpoint, cluster, command).",
        "commands": [
          {
            "command": "0x47",
            "name": "StopMoveStep",
            "args": [
              {
                "field": 0,
                "name": "OptionsMask",
                "type": "u8",
                "value": 1
              },
              {
                "field": 1,
                "name": "OptionsOverride",
                "type": "u8",
                "value": 1
              }
            ]
          }
        ]
      },
      "rule_gated": true,
      "defaults": {
        "data_type": "int",
        "ui_type": "esp.ui.slider",
        "properties": [
          "read",
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.light-mode",
      "matter_match": {
        "cluster": "0x0300",
        "attribute": "0x0008",
        "value_type": "enum8"
      },
      "transform": {
        "type": "enum_map",
        "map": [
          {
            "rmng": 1,
            "matter": 0
          },
          {
            "rmng": 2,
            "matter": 2
          }
        ],
        "matter_aliases": [
          {
            "rmng": 1,
            "matter": 1
          }
        ]
      },
      "shadow_attributes": [
        {
          "attribute": "0x4001",
          "value_type": "enum8",
          "note": "EnhancedColorMode tracks ColorMode: the mirror never writes enhanced-only modes, and values 0/2 are shared between the two"
        }
      ],
      "rule_gated": true,
      "note": "RainMaker Neo HSV(1) <-> ColorMode CurrentHueAndSaturation(0); CCT(2) <-> ColorTemperatureMireds(2); inbound CurrentXAndCurrentY(1) folds to HSV via matter_aliases. No write_as: ColorMode has no setter command (CHIP switches it on color commands), so outbound uses the attribute-write fallback.",
      "defaults": {
        "data_type": "int",
        "ui_type": "esp.ui.dropdown",
        "properties": [
          "read",
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.identify",
      "matter_match": {
        "cluster": "0x0003",
        "attribute": "0x0000",
        "value_type": "u16"
      },
      "transform": {
        "type": "identity"
      },
      "write_as": {
        "commands": [
          {
            "command": "0x00",
            "name": "Identify",
            "args": [
              {
                "field": 0,
                "name": "IdentifyTime",
                "type": "u16",
                "value": "$value"
              }
            ]
          }
        ]
      },
      "defaults": {
        "data_type": "int",
        "properties": [
          "write"
        ]
      }
    },
    {
      "capability": "esp.param.name",
      "matter_match": {
        "cluster": "0x0028",
        "attribute": "0x0005",
        "value_type": "string",
        "node_scoped": true
      },
      "transform": {
        "type": "string",
        "max_len": 32
      },
      "note": "Name <-> BasicInformation.NodeLabel (endpoint 0), bidirectional, truncated to 32 chars, bound only when the node has exactly one Matter-mapped device. A multi-device node has no node-level name: its per-device names stay cloud-side, matched to endpoints through the read-only FixedLabel entry each mirrored endpoint serves (rmng.device = device id, the correlation key). UserLabel is deliberately not a name sink: any controller on the fabric replaces the whole list, so an entry that changes or disappears cannot be read as user intent, and its 16-char cap would clip the name it wrote back.",
      "defaults": {
        "data_type": "string",
        "properties": [
          "read",
          "write"
        ]
      }
    }
  ],
  "composites": [
    {
      "id": "xy_from_hs",
      "params": [
        "esp.param.hue",
        "esp.param.saturation"
      ],
      "matter_match": {
        "cluster": "0x0300",
        "feature_map": "0x00000008",
        "attributes": [
          "0x0003",
          "0x0004"
        ],
        "value_types": [
          "u16",
          "u16"
        ]
      },
      "conversion": {
        "type": "hsv_xy"
      },
      "deferred_persistence": true,
      "note": "CurrentX/CurrentY derived from hue+saturation (sRGB gamut, D65, gamma included; chromaticity only - brightness is LevelControl's). Lowered when all member params are bound on the endpoint; Extended Color Light (0x010D) mandates XY, which is why HS lights need this synthesis - Matter has no HS-only light device type. Inbound XY writes (MoveToColor lands as CurrentX/CurrentY updates) inject hue+saturation atomically (one write_params call). Outbound uses attribute writes: there is no single-value command for an X/Y pair in the write_as machinery, and reports do not disturb ColorMode."
    }
  ],
  "device_types": [
    {
      "device_type": "esp.device.lightbulb",
      "rules": [
        {
          "params": [
            "esp.param.power",
            "esp.param.brightness",
            "esp.param.hue",
            "esp.param.saturation",
            "esp.param.cct"
          ],
          "optional_params": [
            "esp.param.light-mode"
          ],
          "matter_device_type": "0x010D",
          "matter_device_type_version": 4,
          "mandatory_clusters": [
            "0x0003",
            "0x0004",
            "0x0040"
          ],
          "note": "Extended Color Light: XY (mandatory) synthesized via the xy_from_hs composite, CT mandatory, HS optional-but-present. A hue/sat light WITHOUT cct falls through to 0x0101 (dimmable, color cloud-only): 0x010D mandates CT and 0x010C forbids HS, so Matter offers no valid target; CT synthesis from HS is a possible follow-up."
        },
        {
          "params": [
            "esp.param.power",
            "esp.param.brightness",
            "esp.param.cct"
          ],
          "matter_device_type": "0x010C",
          "matter_device_type_version": 4,
          "mandatory_clusters": [
            "0x0003",
            "0x0004",
            "0x0040"
          ]
        },
        {
          "params": [
            "esp.param.power",
            "esp.param.brightness"
          ],
          "matter_device_type": "0x0101",
          "matter_device_type_version": 3,
          "mandatory_clusters": [
            "0x0003",
            "0x0004",
            "0x0040"
          ]
        },
        {
          "params": [
            "esp.param.power"
          ],
          "matter_device_type": "0x0100",
          "matter_device_type_version": 3,
          "mandatory_clusters": [
            "0x0003",
            "0x0004",
            "0x0040"
          ]
        }
      ]
    }
  ]
}
